# PostgreSQL
POSTGRES_USER=jornadas
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=jornadas
DATABASE_URL=postgresql://jornadas:cambia-esta-clave@localhost:5432/jornadas

# API
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://localhost:8080

# Autenticación de un administrador
JWT_SECRET=cambia-este-secreto-largo
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave

# Producción
WEB_PORT=80
